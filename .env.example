# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vistora
REDIS_URL=redis://localhost:6379
# Long random string; used for local JWTs and signed file URLs.
APP_SECRET=change-me-to-a-long-random-string

# ── Auth: local | supabase ───────────────────────────
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage: local | s3 (Cloudflare R2 or Supabase Storage S3 endpoint) ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI providers (server-side only, never exposed to the frontend) ──
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai
TRIPO_API_KEY=
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
# Shared secret appended to provider webhook URLs (?token=...)
PROVIDER_WEBHOOK_SECRET=
# Enables the clearly-labelled procedural Demo provider (never reconstructs your photos)
DEMO_MODE=true

# ── Native tools ─────────────────────────────────────
COLMAP_BIN=colmap
BLENDER_BIN=blender
PYTHON_BIN=../workers/.venv/bin/python
WORKERS_DIR=../workers
WORK_DIR=./.tmp/work
WORKER_CONCURRENCY_PHOTOGRAMMETRY=1
WORKER_CONCURRENCY_PROCESSING=2

# ── Limits ───────────────────────────────────────────
MAX_UPLOAD_MB=40
MAX_IMAGES_PER_PROJECT=200
RATE_LIMIT_PER_MINUTE=300

# ── Frontend (Vite) ──────────────────────────────────
VITE_AUTH_MODE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
